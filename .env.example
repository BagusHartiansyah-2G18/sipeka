# =============================================
# SIMPEG Kesbangpol Sumbawa Barat - .env.local
# =============================================

# DATABASE (MySQL via Prisma)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/simpeg_kesbangpol"

# NEXT AUTH
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ganti-dengan-secret-acak-yang-panjang-dan-aman"

# Upload (opsional - untuk storage file dokumen)
# Jika menggunakan local storage, biarkan kosong
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE_MB=5
